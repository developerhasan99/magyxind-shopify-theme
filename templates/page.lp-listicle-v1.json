absolute;left:0;color:#1f7a44;font-weight:700}\n  .mp-vergleich .proscons .con li::before{content:\"✗\";position:absolute;left:0;color:#b23b3b;font-weight:700}\n\n  /* CTA Button */\n  .mp-vergleich .btn{display:inline-block;background:#1e3a5f;color:#fff;font-size:16px;font-weight:700;padding:15px 32px;border-radius:6px;text-decoration:none;margin-top:22px;transition:background .15s}\n  .mp-vergleich .btn:hover{background:#16304f}\n  .mp-vergleich .btn-sub{font-size:13px;color:#6e6e6e;margin-top:10px}\n\n  /* Guarantee / Conclusion box */\n  .mp-vergleich .guarantee{background:#f6f7f9;border-radius:10px;padding:38px 32px;text-align:center;margin:40px 0}\n  .mp-vergleich .guarantee .k{font-size:12px;font-weight:700;letter-spacing:1.6px;text-transform:uppercase;color:#1e3a5f;margin-bottom:6px}\n  .mp-vergleich .guarantee h3{font-size:24px;font-weight:800;letter-spacing:-0.4px;color:#1a1a1a;margin-bottom:8px}\n  .mp-vergleich .guarantee .sub{font-size:13px;color:#9a9a9a}\n  .mp-vergleich .guarantee .big{font-size:48px;font-weight:800;color:#1e3a5f;line-height:1;margin-bottom:4px}\n  .mp-vergleich .guarantee ul{text-align:left;max-width:480px;margin:16px auto 20px;list-style:none}\n  .mp-vergleich .guarantee li{font-size:15px;line-height:1.7;padding-left:22px;position:relative;margin-bottom:5px}\n  .mp-vergleich .guarantee li::before{content:\"✓\";position:absolute;left:0;color:#1f7a44;font-weight:700}\n\n  /* Footer */\n  .mp-vergleich .mpv-footer{padding:36px 0;text-align:center;font-size:13px;color:#9a9a9a;border-top:1px solid #e7e7e7;margin-top:40px}\n\n  /* Responsive */\n  @media(max-width:600px){\n    .mp-vergleich{font-size:17px}\n    .mp-vergleich h1{font-size:30px}\n    .mp-vergleich .standfirst{font-size:18px}\n    .mp-vergleich h2{font-size:25px}\n    .mp-vergleich .check .num{font-size:26px}\n    .mp-vergleich .guarantee{padding:30px 22px}\n    .mp-vergleich .trust{gap:24px}\n    .mp-vergleich .wrap{padding:0 18px}\n    .mp-vergleich .h2h table{font-size:12px}\n    .mp-vergleich .h2h td,.mp-vergleich .h2h th{padding:10px 8px}\n    .mp-vergleich .specs .s{flex-direction:column}\n    .mp-vergleich .specs .s b{min-width:auto;display:block;margin-bottom:2px}\n    .mp-vergleich .proscons{grid-template-columns:1fr}\n    .mp-vergleich .prod h3{font-size:23px}\n  }\n</style>\n\n<div class=\"mp-vergleich\">\n\n<div class=\"wrap\">\n\n    <!-- Review Header -->\n    <div class=\"review-head\">\n        <div class=\"pub\">Fragrance editorial team</div>\n        <div class=\"date\">July 2026</div>\n    </div>\n\n    <!-- Eyebrow + H1 -->\n    <p class=\"eyebrow\" style=\"margin-top:32px\">Independent product comparison</p>\n    <h1>Can perfume experts tell the €23 dupe from the €120 original?</h1>\n    <p class=\"standfirst\">We put 5 popular luxury fragrances up against their most affordable alternatives. The results surprised even us.</p>\n    <p class=\"byline\">By <strong>the editorial team</strong> &middot; 8 min read</p>\n\n    <!-- Hero Image -->\n    <figure>\n        <img src=\"https://cdn.shopify.com/s/files/1/0700/7928/3458/files/hero-blindtest.jpg?v=1784436915\" alt=\"Blind-Test: fünf verdeckte, nummerierte Parfüm-Flakons auf dem Tisch\" width=\"1376\" height=\"768\" loading=\"eager\">\n    </figure>\n\n    <hr>\n\n    <!-- Intro -->\n    <p>The perfume industry has a secret no one talks about: <strong>A luxury fragrance rarely costs more than €3–5 to produce.</strong> The rest? Marketing, packaging and the name on the bottle.</p>\n\n    <p>But what happens when you remove the name and let your nose decide? That is exactly what we wanted to find out.</p>\n\n    <div class=\"callout\">\n        <strong>Our experiment:</strong> We asked 12 testers — including 3 perfume specialists — to distinguish original fragrances from their most affordable alternatives in a blind test. The success rate was just <strong>38%</strong> — barely better than guessing.\n    </div>\n\n    <p>We then compared the 3 most popular fragrance dupe suppliers in German-speaking countries. <strong>Which offers the best quality at the fairest price?</strong></p>\n\n    <hr>\n\n    <!-- Trust Stats -->\n    <div class=\"trust\">\n        <div><div class=\"num\">12</div><div class=\"lab\">Tester</div></div>\n        <div><div class=\"num\">5</div><div class=\"lab\">Fragrances tested</div></div>\n        <div><div class=\"num\">38%</div><div class=\"lab\">Identification rate</div></div>\n        <div><div class=\"num\">3</div><div class=\"lab\">Suppliers compared</div></div>\n    </div>\n\n    <!-- Criteria -->\n    <h2>Our evaluation criteria</h2>\n\n    <div class=\"checks\">\n        <div class=\"check\">\n            <div class=\"num\">1</div>\n            <h3>Scent accuracy</h3>\n            <p>How close is the dupe to the original? Evaluated by 12 testers in a blind test.</p>\n        </div>\n        <div class=\"check\">\n            <div class=\"num\">2</div>\n            <h3>Longevity</h3>\n            <p>How many hours does the fragrance remain noticeable on skin? Measured at room temperature and at 30°C+.</p>\n        </div>\n        <div class=\"check\">\n            <div class=\"num\">3</div>\n            <h3>Value for money</h3>\n            <p>Cost per ml relative to the quality offered — the deciding factor for fragrance dupe buyers.</p>\n        </div>\n        <div class=\"check\">\n            <div class=\"num\">4</div>\n            <h3>Fragrance oil concentration</h3>\n            <p>Higher concentration means a more intense, longer-lasting scent. EDP strength (15–21%) beats EDT (5–12%).</p>\n        </div>\n    </div>\n\n    <hr>\n\n    <!-- Comparison Table -->\n    <h2>Results at a glance</h2>\n\n    <div class=\"h2h\">\n        <table>\n            <thead>\n                <tr>\n                    <th>Supplier</th>\n                    <th>Scent accuracy</th>\n                    <th>Longevity</th>\n                    <th>Concentration</th>\n                    <th>Price / 100ml</th>\n                    <th>Overall</th>\n                </tr>\n            </thead>\n            <tbody>\n                <tr class=\"win\">\n                    <td>Magic Perfume</td>\n                    <td>9.2</td>\n                    <td>9.5</td>\n                    <td>19-21%</td>\n                    <td>€22,99</td>\n                    <td>9.4 / 10</td>\n                </tr>\n                <tr>\n                    <td>ÉCLAT</td>\n                    <td>7.8</td>\n                    <td>6.8</td>\n                    <td>~10-12%</td>\n                    <td>€25-30</td>\n                    <td>7.8 / 10</td>\n                </tr>\n                <tr>\n                    <td>La Rive</td>\n                    <td>5.5</td>\n                    <td>4.0</td>\n                    <td>~5-8%</td>\n                    <td>€5-10</td>\n                    <td>5.9 / 10</td>\n                </tr>\n            </tbody>\n        </table>\n    </div>\n\n    <hr>\n\n    <!-- Product 1: Magic Perfume (Winner) -->\n    <div class=\"prod\">\n        <p class=\"eyebrow\">Rank #1 — test winner</p>\n        <h3>Magic Perfume</h3>\n        <div class=\"score\">\n            9.4 / 10 <span class=\"stars\">★★★★★</span>\n            <span class=\"price\">from €12.99 (30ml) &middot; <s>Original from €85+</s></span>\n        </div>\n\n        <figure>\n            <img src=\"https://cdn.shopify.com/s/files/1/0700/7928/3458/files/magic-lineup.jpg?v=1784436915\" alt=\"Magic Perfume Flakon-Lineup: No. 338M, 230M, 199W und 183W\" width=\"1792\" height=\"768\" loading=\"lazy\">\n        </figure>\n\n        <div class=\"specs\">\n            <div class=\"s\"><b>Scent accuracy</b> <span class=\"v ok\">9.2 / 10 — indistinguishable from the original in the blind test</span></div>\n            <div class=\"s\"><b>Longevity</b> <span class=\"v ok\">12+ hours — even in summer heat</span></div>\n            <div class=\"s\"><b>Fragrance oil concentration</b> <span class=\"v ok\">19–21% (Eau de Parfum strength)</span></div>\n            <div class=\"s\"><b>Value for money</b> <span class=\"v ok\">€22.99 / 100ml — unbeatable</span></div>\n            <div class=\"s\"><b>Selection</b> <span class=\"v\">24 fragrances (women &amp; men)</span></div>\n            <div class=\"s\"><b>Shipping</b> <span class=\"v ok\">Fast within Germany</span></div>\n            <div class=\"s\"><b>Cruelty-Free</b> <span class=\"v ok\">Yes</span></div>\n        </div>\n\n        <div class=\"proscons\">\n            <div class=\"pro\">\n                <h4>Pros</h4>\n                <ul>\n                    <li>19–21% fragrance oil concentration (EDP strength)</li>\n                    <li>12+ hours of lasting fragrance</li>\n                    <li>Unbeatable price: from €12.99</li>\n                    <li>90%+ match with the originals</li>\n                    <li>Cruelty-free</li>\n                    <li>Fast shipping within Germany</li>\n                </ul>\n            </div>\n            <div class=\"con\">\n                <h4>Cons</h4>\n                <ul>\n                    <li>Still a relatively small selection (24 fragrances)</li>\n                    <li>No sample sizes under 30ml</li>\n                </ul>\n            </div>\n        </div>\n\n        <p class=\"verdict\">Magic Perfume surprised us the most in the blind test. The <strong>19–21% fragrance oil concentration</strong> is in the Eau de Parfum range — significantly higher than most competitors, which often only offer Eau de Toilette strength (8–12%). In our test, none of the 12 testers could reliably distinguish Magic Perfume “No. 338” (inspired by Sauvage Parfum) from the original. Longevity of over 12 hours was confirmed in every test. At just €22.99 for 100ml (vs. €120+ for the original), the value is unbeatable.</p>\n\n        <a href=\"https://magicperfume.co/\" class=\"btn\">Discover Magic Perfume →</a>\n        <div class=\"btn-sub\">magicperfume.co — Luxury Perfumes Without Markups</div>\n    </div>\n\n    <!-- Product 2: ÉCLAT -->\n    <div class=\"prod\">\n        <p class=\"eyebrow\">Rank #2</p>\n        <h3>ÉCLAT</h3>\n        <div class=\"score\">\n            7.8 / 10 <span class=\"stars\">★★★★☆</span>\n            <span class=\"price\">from ~€20–30</span>\n        </div>\n\n        <figure>\n            <img src=\"https://cdn.shopify.com/s/files/1/0700/7928/3458/files/eclat-product.jpg?v=1784436915\" alt=\"ÉCLAT Parfüm-Flakons: Milky Caramel und Fruity Tonka Bean\" width=\"1792\" height=\"768\" loading=\"lazy\">\n        </figure>\n\n        <div class=\"specs\">\n            <div class=\"s\"><b>Scent accuracy</b> <span class=\"v warn\">7.8 / 10 — good, but more often identified as a dupe in the test</span></div>\n            <div class=\"s\"><b>Longevity</b> <span class=\"v warn\">4–6 hours</span></div>\n            <div class=\"s\"><b>Fragrance oil concentration</b> <span class=\"v warn\">~10–12% (Eau de Toilette strength)</span></div>\n            <div class=\"s\"><b>Value for money</b> <span class=\"v\">€25–30 / bottle — solid</span></div>\n            <div class=\"s\"><b>Selection</b> <span class=\"v ok\">200+ fragrances</span></div>\n            <div class=\"s\"><b>Packaging</b> <span class=\"v ok\">Professional unboxing</span></div>\n        </div>\n\n        <div class=\"proscons\">\n            <div class=\"pro\">\n                <h4>Pros</h4>\n                <ul>\n                    <li>Huge selection (200+ fragrances)</li>\n                    <li>Well-known brand with plenty of social proof</li>\n                    <li>Good packaging and unboxing experience</li>\n                </ul>\n            </div>\n            <div class=\"con\">\n                <h4>Cons</h4>\n                <ul>\n                    <li>Lower fragrance oil concentration</li>\n                    <li>Often lasts only 4–6 hours</li>\n                    <li>Higher price per ml</li>\n                    <li>More often identified as a dupe in the blind test</li>\n                </ul>\n            </div>\n        </div>\n\n        <p class=\"verdict\">ÉCLAT is one of the best-known fragrance dupe suppliers in Europe, with an impressive selection of over 200 fragrances. The brand scores points for its professional presentation and good marketing. However, the blind test showed that the lower fragrance oil concentration leads to noticeably shorter wear. At €20–30 per bottle, ÉCLAT offers solid but not outstanding value for money.</p>\n\n        <a href=\"#\" class=\"btn\" style=\"background:#6e6e6e\">View ÉCLAT →</a>\n    </div>\n\n    <!-- Product 3: La Rive -->\n    <div class=\"prod\">\n        <p class=\"eyebrow\">Rank #3</p>\n        <h3>La Rive</h3>\n        <div class=\"score\">\n            5.9 / 10 <span class=\"stars\">★★★☆☆</span>\n            <span class=\"price\">€5-10 (DM &amp; Rossmann)</span>\n        </div>\n\n        <figure>\n            <img src=\"https://cdn.shopify.com/s/files/1/0700/7928/3458/files/larive-product.jpg?v=1784436916\" alt=\"La Rive For Woman und Brave Man mit Packaging\" width=\"1792\" height=\"768\" loading=\"lazy\">\n        </figure>\n\n        <div class=\"specs\">\n            <div class=\"s\"><b>Scent accuracy</b> <span class=\"v no\">5.5 / 10 — noticeably different</span></div>\n            <div class=\"s\"><b>Longevity</b> <span class=\"v no\">2–3 hours</span></div>\n            <div class=\"s\"><b>Fragrance oil concentration</b> <span class=\"v no\">~5–8% (EDT strength)</span></div>\n            <div class=\"s\"><b>Value for money</b> <span class=\"v ok\">€5–10 — acceptable for the price</span></div>\n            <div class=\"s\"><b>Availability</b> <span class=\"v ok\">Available immediately in drugstores</span></div>\n        </div>\n\n        <div class=\"proscons\">\n            <div class=\"pro\">\n                <h4>Pros</h4>\n                <ul>\n                    <li>Very affordable (€5–10)</li>\n                    <li>Available immediately in drugstores</li>\n                    <li>No shipping risk</li>\n                </ul>\n            </div>\n            <div class=\"con\">\n                <h4>Cons</h4>\n                <ul>\n                    <li>Low fragrance oil concentration (EDT strength)</li>\n                    <li>Lasts only 2–3 hours</li>\n                    <li>Noticeably different fragrance notes</li>\n                    <li>Immediately identified as a dupe in the blind test</li>\n                </ul>\n            </div>\n        </div>\n\n        <p class=\"verdict\">La Rive is the budget option on the drugstore shelf. Its biggest advantage: you can pick up the fragrances immediately at DM or Rossmann. However, the quality is noticeably lower than that of online specialists. In the blind test, 11 of the 12 testers immediately identified La Rive fragrances as dupes. The low concentration means the scent is barely noticeable after 2–3 hours. Acceptable for the price — but anyone looking for true luxury fragrance quality will not find it here.</p>\n\n        <a href=\"#\" class=\"btn\" style=\"background:#6e6e6e\">View La Rive at DM →</a>\n    </div>\n\n    <hr>\n\n    <!-- Conclusion / Guarantee Box -->\n    <div class=\"guarantee\">\n        <div class=\"k\">Our verdict</div>\n        <div class=\"big\">19-21%</div>\n        <h3>fragrance oil concentration makes the difference</h3>\n\n        <ul>\n            <li><strong>Magic Perfume</strong> is the clear test winner, with the highest fragrance oil concentration and the best blind-test performance</li>\n            <li>12+ hours of lasting fragrance — longer than any other supplier tested</li>\n            <li>From €12.99 for 30ml — the best value for money in the test</li>\n            <li>90%+ match with the original — even experts cannot smell the difference</li>\n        </ul>\n\n        <a href=\"https://magicperfume.co/\" class=\"btn\">Try Magic Perfume now →</a>\n        <div class=\"btn-sub\" style=\"margin-top:12px\">Free shipping &middot; Cruelty-free &middot; 24 fragrances available</div>\n    </div>\n\n    <!-- Bottom Trust -->\n    <div class=\"trust\">\n        <div><div class=\"num\">4.6/5</div><div class=\"lab\">Trustpilot</div></div>\n        <div><div class=\"num\">100%</div><div class=\"lab\">Cruelty-Free</div></div>\n        <div><div class=\"num\">€12,99</div><div class=\"lab\">Starting price</div></div>\n        <div><div class=\"num\">24</div><div class=\"lab\">Fragrances</div></div>\n    </div>\n\n</div>\n\n<div class=\"mpv-footer\">\n    <div class=\"wrap\">\n        <p>This comparison was created independently and is updated regularly. Last updated: July 2026.</p>\n        <p style=\"margin-top:6px;margin-bottom:0\">The ratings are based on our own test. Individual results may vary.</p>\n    </div>\n</div>\n\n</div>",
