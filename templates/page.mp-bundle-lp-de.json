    "faq": {
      "type": "mp-lp-faq",
      "blocks": {
        "faq-1": {
          "type": "faq",
          "settings": {
            "question": "Why are your perfumes so affordable?",
            "answer": "We put the money into what is inside the bottle. No luxury bottle, special packaging, expensive shops or costly influencer deals. That way you smell luxurious without breaking your budget.",
            "open": true
          }
        },
        "faq-2": {
          "type": "faq",
          "settings": {
            "question": "Is this an Eau de Toilette?",
            "answer": "No, it is an Eau de Parfum. It contains 21% perfume oil. An Eau de Toilette, for example, contains between 5 and 15%.",
            "open": false
          }
        },
        "faq-3": {
          "type": "faq",
          "settings": {
            "question": "How long does the perfume last?",
            "answer": "Sprayed on skin, it lasts 8 to 12 hours or longer, thanks to our formula and 21% perfume oil concentration.",
            "open": false
          }
        },
        "faq-4": {
          "type": "faq",
          "settings": {
            "question": "Does the inspired fragrance smell different?",
            "answer": "This fragrance is inspired by similar notes and belongs to the same fragrance family.",
            "open": false
          }
        },
        "faq-5": {
          "type": "faq",
          "settings": {
            "question": "What does 21% perfume mean?",
            "answer": "It means the contents of the bottle contain 21% perfume oil.",
            "open": false
          }
        },
        "faq-6": {
          "type": "faq",
          "settings": {
            "question": "How can this be legal?",
            "answer": "Fragrance compositions themselves are not protected by intellectual property rights, so they can legally be recreated.",
            "open": false
          }
        },
        "faq-7": {
          "type": "faq",
          "settings": {
            "question": "How do I build my box?",
            "answer": "Choose any six bottles from the {count} fragrances above, for women, for men or a mix. Every bottle is 50ml. Once all six slots are full, tap the button to go straight to checkout.",
            "open": false
          }
        },
        "faq-8": {
          "type": "faq",
          "settings": {
            "question": "When do you dispatch?",
            "answer": "We usually dispatch on the second working day.",
            "open": false
          }
        },
        "faq-9": {
          "type": "faq",
          "settings": {
            "question": "What if I want to return it?",
            "answer": "Unopened bottles can be returned within 60 days of delivery. We process the refund within 14 working days after the parcel arrives. Email hello@magicperfume.co.",
            "open": false
